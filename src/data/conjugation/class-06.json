  {
    "id": "class-06-conjugation-002",
    "appliesTo": "verb-ichidan",
    "form": "imperative",
    "explanation": [
      {
        "en": "Rude imperative: ichidan verbs use the -e stem + ろ (食べる→食べろ, 見る→見ろ). Irregular: 来る→来い(こい), する→しろ."
      }
    ],
    "examples": [
      {
        "form": "imperative",
        "surface": "食べろ",
        "reading": "たべろ"
      },
      {
        "form": "imperative",
        "surface": "見ろ",
        "reading": "みろ"
      },
      {
        "form": "imperative",
        "surface": "来い",
        "reading": "こい"
      },
      {
        "form": "imperative",
        "surface": "しろ"
      }
    ],
    "exceptions": [
      "来る → 来い (こい), する → しろ — irregular, not -e+ろ"
    ],
    "lessonIds": [
      "class-06"
    ],
    "origin": "course",
