  {
    "id": "class-06-conjugation-003",
    "appliesTo": "verb-godan",
    "form": "imperative-negative",
    "explanation": [
      {
        "en": "Rude negative imperative (\"don't [verb]\"): dictionary (-u) form + な, for both godan and ichidan verbs, no exceptions. 飲む→飲むな, 話す→話すな, 食べる→食べるな, 見る→見るな."
      }
    ],
    "examples": [
      {
        "form": "imperative-negative",
        "surface": "飲むな",
        "reading": "のむな"
      },
      {
        "form": "imperative-negative",
        "surface": "話すな",
        "reading": "はなすな"
      },
      {
        "form": "imperative-negative",
        "surface": "食べるな",
        "reading": "たべるな"
      },
      {
        "form": "imperative-negative",
        "surface": "見るな",
        "reading": "みるな"
      }
    ],
    "lessonIds": [
