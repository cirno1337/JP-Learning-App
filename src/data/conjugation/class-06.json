    "form": "imperative",
    "explanation": [
      {
        "en": "Rude imperative: godan verbs use the -e stem alone (飲む→飲め, 話す→話せ)."
      }
    ],
    "examples": [
      {
        "form": "imperative",
        "surface": "飲め",
        "reading": "のめ"
      },
