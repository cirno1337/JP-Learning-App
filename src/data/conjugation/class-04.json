  {
    "id": "class-04-conjugation-005",
    "appliesTo": "verb-ichidan",
    "form": "nakatta",
    "explanation": [
      {
        "en": "Past casual negative: take the present casual negative (-a stem + ない) and treat ない as an i-adjective, replacing い with かった. 話さない→話さなかった, 食べない→食べなかった, しない→しなかった, 寝ない→寝なかった. じゃない similarly becomes じゃなかった."
      }
    ],
    "examples": [
      {
        "form": "nakatta",
        "surface": "話さなかった",
        "reading": "はなさなかった"
      },
      {
        "form": "nakatta",
        "surface": "食べなかった",
        "reading": "たべなかった"
      },
      {
        "form": "nakatta",
        "surface": "しなかった"
      },
      {
        "form": "nakatta",
        "surface": "寝なかった",
        "reading": "ねなかった"
      },
      {
        "form": "nakatta",
        "surface": "じゃなかった"
      }
    ],
    "lessonIds": [
      "class-04"
    ],
