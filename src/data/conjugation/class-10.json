  {
    "id": "class-10-conjugation-002",
    "appliesTo": "verb-godan",
    "form": "ta",
    "explanation": [
      {
        "en": "Conditional たら (hypothetical situation, wish, will, request): ta-form + ら. 飲んだら (what if you drink), 食べたら (what if you eat), 書いたら (what if you write)."
      }
    ],
    "examples": [
      {
        "form": "ta",
        "surface": "飲んだら",
        "reading": "のんだら"
      },
      {
        "form": "ta",
        "surface": "書いたら",
        "reading": "かいたら"
      }
    ],
