    "id": "class-10-conjugation-001",
    "appliesTo": "verb-godan",
    "form": "dictionary",
    "explanation": [
      {
        "en": "Conditional と (general facts/habits — \"whenever X, Y always happens\"): plain dictionary or negative form + と. 飲むと (if/when you drink), 書かないと (if/when you don't write)."
      }
    ],
    "examples": [
      {
        "form": "dictionary",
        "surface": "飲むと",
        "reading": "のむと"
      },
      {
        "form": "dictionary",
        "surface": "書かないと",
        "reading": "かかないと"
      }
    ],
