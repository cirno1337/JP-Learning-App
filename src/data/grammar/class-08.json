  {
    "id": "class-08-grammar-004",
    "pattern": "Adverbs of quantity",
    "explanation": [
      {
        "en": "十分(じゅうぶん) = enough; 足りない(たりない) = not enough; たくさん = a lot; いくつか = some. Placed before the verb they modify, like other adverbs."
      }
    ],
    "examples": [
      {
