    "id": "class-10-grammar-002",
    "pattern": "Must / have to (なければならない)",
    "explanation": [
      {
        "en": "\"Must/have to [verb]\" = -a stem + なければならない, casually shortened to -a stem + なきゃ (ならない can be dropped in casual speech)."
      }
    ],
    "examples": [
      {
        "id": "class-10-example-010",
        "japanese": "日本語を勉強しなければならない。",
        "meanings": [
