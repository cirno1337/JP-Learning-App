  {
    "id": "class-03-grammar-002",
    "pattern": "たい (want to)",
    "explanation": [
      {
        "en": "Expresses wanting to do an action: verb -i (masu) stem + たい. Declines like an i-adjective for negative/past/polite."
      }
    ],
    "examples": [
